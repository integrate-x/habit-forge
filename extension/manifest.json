{
  "manifest_version": 3,
  "name": "Habit Forge",
  "version": "0.1.0",
  "description": "Minimal website blocker companion for Habit Forge.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "declarativeNetRequest",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Habit Forge",
    "default_popup": "popup.html"
  }
}

